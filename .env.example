# ── Ofrenda Environment Configuration Template ────────────────────────────
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Ollama local inference endpoint & model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# (Optional) ElevenLabs Voice Synthesis & Speech-to-Text
# Leave blank to run 100% offline with zero cloud transmission.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# (Optional) Mastra Local Memory Agent
MASTRA_URL=http://127.0.0.1:8787

# (Optional) Ultramarine Cloud Comparison Benchmark
ULTRAMARINE_API_KEY=
ULTRAMARINE_BASE_URL=
ULTRAMARINE_MODEL=
ULTRAMARINE_PRICE_IN=0.15
ULTRAMARINE_PRICE_OUT=0.50

